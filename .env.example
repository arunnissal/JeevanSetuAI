# ==============================================================================
# JeevanSetu AI - Unified Environment Variables Example
# ==============================================================================
# Copy this file to:
#   1. backend/.env   (for the Django backend service)
#   2. frontend/.env  (for the React Native / Expo web client)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Django Backend Configurations (backend/.env)
# ------------------------------------------------------------------------------
DEBUG=True
SECRET_KEY=django-insecure-your-secret-key-here
ALLOWED_HOSTS=localhost,127.0.0.1,jeevansetuai.onrender.com

# Database Connection (Falls back to local SQLite if left empty)
DATABASE_URL=postgresql://neondb_owner:password@ep-wandering-block.aws.neon.tech/neondb?sslmode=require

# External AI Provider Integration (Sarvam AI)
SARVAM_API_KEY=your_sarvam_ai_api_subscription_key_here

# Cloud-based Media Storage (Cloudinary)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# CORS Allowed Origins (Comma-separated for frontend clients)
CORS_ALLOWED_ORIGINS=http://localhost:19006,https://jeevan-setu-ai-nine.vercel.app

# ------------------------------------------------------------------------------
# 2. Frontend Client Configurations (frontend/.env)
# ------------------------------------------------------------------------------
EXPO_PUBLIC_API_URL=http://localhost:8000/api/v1
EXPO_PUBLIC_ENV=development
EXPO_PUBLIC_APP_NAME=JeevanSetu AI
EXPO_PUBLIC_VERSION=1.0.0
